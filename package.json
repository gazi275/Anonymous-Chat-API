{
  "name": "anonymous-chat-api",
  "version": "1.0.0",
  "private": true,
  "description": "Anonymous real-time chat API built with NestJS, PostgreSQL, Drizzle ORM, Redis, and Socket.io.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "drizzle:generate": "drizzle-kit generate --config drizzle.config.js --out ./drizzle/migrations",
    "drizzle:push": "drizzle-kit push --config drizzle.config.js",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.0",
    "@nestjs/websockets": "^10.4.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "drizzle-orm": "^0.38.4",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "redis": "^4.7.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.17",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}